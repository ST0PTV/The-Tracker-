{
  "name": "the-tracker",
  "private": true,
  "type": "module",
  "description": "The Tracker PWA – package.json nur für Tests und Syntaxprüfung, keine Build-Abhängigkeiten.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "privacy": "sh scripts/privacy-scan.sh",
    "release": "node scripts/release.mjs",
    "test:browser": "node tests/browser/check-tabs.mjs && node tests/browser/check-journal.mjs"
  }
}
